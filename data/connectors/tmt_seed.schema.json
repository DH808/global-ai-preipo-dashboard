{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private-investment-os.local/data/connectors/tmt_seed.schema.json",
  "title": "Reviewed North America TMT seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "review", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "asOf": {"type": "string", "format": "date"},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewedBy", "reviewedAt"],
      "properties": {
        "status": {"const": "approved"},
        "reviewedBy": {"type": "string", "minLength": 1},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "aliases", "headquartersCountry", "tmtVertical", "businessModel", "customerType", "monetization", "lifecycleStage", "sourceVintage", "sources", "confidence", "privateStatusBoundary", "investabilityAccessLane"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "uniqueItems": true},
          "headquartersCountry": {"enum": ["United States", "Canada", "Mexico"]},
          "tmtVertical": {"enum": ["AI/Cloud/Semiconductor Infrastructure", "Enterprise Software", "Data/Analytics", "Cybersecurity/Identity", "Fintech/Payments/Insurtech", "Commerce/Marketplaces", "Consumer Internet/Media/Gaming", "Digital Health", "Climate/Industrial Tech", "Space/Communications", "Robotics/Mobility", "Other"]},
          "businessModel": {"enum": ["SaaS", "Usage-based", "Transactional", "Marketplace", "Advertising", "Subscription", "Hardware", "Hardware + Software", "Licensing", "Services", "Project-based", "Other"]},
          "customerType": {"enum": ["B2B", "B2C", "B2B2C", "B2G", "Mixed", "Other"]},
          "monetization": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["Subscription", "Usage-based", "Transaction fees", "Take rate", "Advertising", "Licensing", "Hardware sales", "Services", "Insurance premium", "Interest/net interest", "Other"]}},
          "lifecycleStage": {"enum": ["formation_pre_seed", "seed", "series_a_b", "growth_late_stage", "pre_ipo", "secondary_tender", "crossover_pipe_strategic", "project_finance"]},
          "sourceVintage": {"type": "string", "format": "date"},
          "confidence": {"enum": ["low", "medium", "high"]},
          "investabilityAccessLane": {"enum": ["direct_primary", "company_approved_secondary", "fund_spv", "strategic_co_invest", "relationship_development", "monitor_only", "unknown"]},
          "sector": {"type": "string", "maxLength": 200},
          "subSector": {"type": "string", "maxLength": 200},
          "companyDescription": {"type": "string", "maxLength": 500},
          "privateStatusBoundary": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "asOf", "sourceUrl", "confidence"],
            "properties": {
              "status": {"const": "private"}, "asOf": {"type": "string", "format": "date"},
              "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
              "confidence": {"enum": ["medium", "high"]}
            }
          },
          "sources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["url", "date", "type", "confidence"],
              "properties": {
                "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
                "date": {"type": "string", "format": "date"},
                "type": {"enum": ["official", "regulatory", "company_release", "reputable_media", "investor_release"]},
                "confidence": {"enum": ["low", "medium", "high"]}
              }
            }
          }
        }
      }
    }
  }
}
